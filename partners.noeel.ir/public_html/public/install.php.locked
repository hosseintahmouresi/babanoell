$root=dirname(__DIR__);$storage=$root.'/storage';$lock=$storage.'/installed.lock';$local=$root.'/config/local.env.php';
spl_autoload_register(static function(string$class)use($root):void{$prefix='Babanoell\\Partners\\';if(!str_starts_with($class,$prefix))return;$file=$root.'/src/'.str_replace('\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require$file;});
foreach([$storage,$storage.'/tmp',$storage.'/backups']as$d)if(!is_dir($d))@mkdir($d,0770,true);if(is_dir($storage.'/tmp')&&is_writable($storage.'/tmp'))session_save_path($storage.'/tmp');session_name('babanoell_partners_install');session_set_cookie_params(['lifetime'=>0,'path'=>'/','secure'=>(!empty($_SERVER['HTTPS'])&&$_SERVER['HTTPS']!=='off'),'httponly'=>true,'samesite'=>'Strict']);session_start();
header('X-Content-Type-Options:nosniff');header('X-Frame-Options:DENY');header('Referrer-Policy:no-referrer');header('X-Robots-Tag:noindex,nofollow,noarchive');header('Cache-Control:no-store,max-age=0');header("Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'");
function partners_csrf():string{if(!is_string($_SESSION['_csrf']??null))$_SESSION['_csrf']=bin2hex(random_bytes(24));return$_SESSION['_csrf'];}function partners_csrf_ok():bool{return is_string($_POST['_csrf']??null)&&is_string($_SESSION['_csrf']??null)&&hash_equals($_SESSION['_csrf'],$_POST['_csrf']);}
function partners_probe(string$base,string$path='/healthz'):bool{$url=rtrim($base,'/').$path;if(function_exists('curl_init')){$ch=curl_init($url);if($ch===false)return false;curl_setopt_array($ch,[CURLOPT_RETURNTRANSFER=>true,CURLOPT_TIMEOUT=>7,CURLOPT_CONNECTTIMEOUT=>4,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_SSL_VERIFYHOST=>2,CURLOPT_HTTPHEADER=>['Accept: application/json','User-Agent: BabanoellPartnersInstaller/1.0.0']]);$raw=curl_exec($ch);$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);curl_close($ch);}else{$ctx=stream_context_create(['http'=>['timeout'=>7,'ignore_errors'=>true,'follow_location'=>0,'header'=>"Accept: application/json\r\nUser-Agent: BabanoellPartnersInstaller/1.0.0"],'ssl'=>['verify_peer'=>true,'verify_peer_name'=>true]]);$raw=@file_get_contents($url,false,$ctx);$status=0;foreach($http_response_header??[]as$line)if(preg_match('#^HTTP/\S+\s+(\d{3})#',$line,$m)){$status=(int)$m[1];break;}}$json=is_string($raw)?json_decode($raw,true):null;return$status>=200&&$status<300&&is_array($json)&&($json['status']??$json['data']['status']??null)==='ok';}
function partners_export(array$v):string{return var_export($v,true);}
if(is_file($lock)&&is_file($local)){echo Renderer::page('وضعیت نصب','<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">وضعیت سرویس</div><h1 class="bn-title">سرویس شرکا قبلاً نصب شده است</h1><p class="bn-subtitle">برای بررسی وضعیت از healthz و برای نسخه‌های بعدی از update.php استفاده کنید.</p></div></div><div class="bn-alert bn-alert--success"><strong>نصب اولیه کامل است.</strong></div>');exit;}
$requirements=[['PHP ۸.۱ یا بالاتر',PHP_VERSION_ID>=80100,PHP_VERSION],['PDO MySQL',extension_loaded('pdo_mysql'),extension_loaded('pdo_mysql')?'فعال':'غیرفعال'],['JSON',extension_loaded('json'),'فعال'],['دسترسی نوشتن storage',is_writable($storage),is_writable($storage)?'قابل نوشتن':'غیرقابل نوشتن']];
$values=['environment'=>(string)($_POST['environment']??'production'),'db_host'=>trim((string)($_POST['db_host']??'localhost')),'db_port'=>trim((string)($_POST['db_port']??'3306')),'db_name'=>trim((string)($_POST['db_name']??'')),'db_user'=>trim((string)($_POST['db_user']??'')),'identity_url'=>trim((string)($_POST['identity_url']??'https://identity.noeel.ir')),'loans_url'=>trim((string)($_POST['loans_url']??'https://loans.noeel.ir')),'documents_url'=>trim((string)($_POST['documents_url']??'https://documents.noeel.ir')),'service_auth_mode'=>strtolower(trim((string)($_POST['service_auth_mode']??'optional')))];$errors=[];$applied=[];
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
 if(!partners_csrf_ok())$errors[]='اعتبار فرم نصب منقضی شده است. صفحه را تازه‌سازی کنید.';foreach($requirements as$r)if(!$r[1])$errors[]='پیش‌نیاز «'.$r[0].'» برقرار نیست.';if(!in_array($values['environment'],['staging','production'],true))$errors[]='محیط اجرا معتبر نیست.';if(!in_array($values['service_auth_mode'],['disabled','optional','required'],true))$errors[]='حالت احراز هویت سرویس معتبر نیست.';if($values['db_name']===''||$values['db_user']===''||trim((string)($_POST['db_password']??''))==='')$errors[]='نام دیتابیس، کاربر و رمز دیتابیس الزامی است.';
 foreach(['identity_url'=>'Identity','loans_url'=>'Loans','documents_url'=>'Documents']as$k=>$label){if(filter_var($values[$k],FILTER_VALIDATE_URL)===false)$errors[]='آدرس '.$label.' معتبر نیست.';if($values['environment']==='production'&&!str_starts_with(strtolower($values[$k]),'https://'))$errors[]='در محیط عملیاتی، '.$label.' باید HTTPS باشد.';}
 if($values['service_auth_mode']==='required'&&trim((string)($_POST['service_auth_secret']??''))==='')$errors[]='برای حالت required، کلید مشترک سرویس الزامی است.';
 if($errors===[]&&!partners_probe($values['identity_url']))$errors[]='ارتباط سلامت با Identity تأیید نشد.';if($errors===[]&&!partners_probe($values['loans_url']))$errors[]='ارتباط سلامت با Loans تأیید نشد.';if($errors===[]&&!partners_probe($values['documents_url']))$errors[]='ارتباط سلامت با Documents تأیید نشد.';
 if($errors===[]){try{$port=(int)$values['db_port'];$dsn=sprintf('mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4',$values['db_host'],$port,$values['db_name']);$pdo=new PDO($dsn,$values['db_user'],(string)$_POST['db_password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_DEFAULT_FETCH_MODE=>PDO::FETCH_ASSOC,PDO::ATTR_EMULATE_PREPARES=>false]);$pdo->query('SELECT 1')->fetchColumn();DatabaseIsolationGuard::assertPartnersDatabase($pdo);$applied=(new MigrationRunner($pdo,$root.'/database/migrations'))->up();}catch(Throwable$e){@file_put_contents($storage.'/install-error.log','['.gmdate('c').'] '.get_class($e).': '.$e->getMessage()."\n",FILE_APPEND|LOCK_EX);$errors[]='اتصال یا ساخت ساختار دیتابیس کامل نشد. جزئیات فنی در storage/install-error.log ثبت شد.';}}
 if($errors===[]){$cfg=['APP_ENV'=>$values['environment'],'SERVICE_NAME'=>'partners','PARTNERS_DB_HOST'=>$values['db_host'],'PARTNERS_DB_PORT'=>$values['db_port'],'PARTNERS_DB_NAME'=>$values['db_name'],'PARTNERS_DB_USER'=>$values['db_user'],'PARTNERS_DB_PASSWORD'=>(string)$_POST['db_password'],'PARTNERS_DB_CHARSET'=>'utf8mb4','PARTNERS_IDENTITY_BASE_URL'=>rtrim($values['identity_url'],'/'),'PARTNERS_LOANS_BASE_URL'=>rtrim($values['loans_url'],'/'),'PARTNERS_DOCUMENTS_BASE_URL'=>rtrim($values['documents_url'],'/'),'PARTNERS_HTTP_TIMEOUT_SECONDS'=>'8','NOEEL_SERVICE_SHARED_SECRET'=>trim((string)($_POST['service_auth_secret']??'')),'NOEEL_SERVICE_AUTH_MODE'=>$values['service_auth_mode']];$content="<?php\ndeclare(strict_types=1);\n\n// Generated by Partners installer. KEEP PRIVATE.\nreturn ".partners_export($cfg).";\n";$tmp=$local.'.tmp-'.bin2hex(random_bytes(4));if(file_put_contents($tmp,$content,LOCK_EX)===false||!rename($tmp,$local))$errors[]='فایل config/local.env.php ساخته نشد.';}
 if($errors===[]){try{require_once$root.'/config/env.php';$config=Babanoell\Partners\App\Config::fromEnvironment();$runtime=Babanoell\Partners\Database\Connection::fromConfig($config);$runtime->query('SELECT 1')->fetchColumn();if((string)$runtime->query('SELECT DATABASE()')->fetchColumn()!==$values['db_name'])throw new RuntimeException('runtime database mismatch');}catch(Throwable$e){@file_put_contents($storage.'/install-error.log','['.gmdate('c').'] runtime: '.$e->getMessage()."\n",FILE_APPEND|LOCK_EX);$errors[]='بررسی نهایی مسیر واقعی سرویس موفق نبود. قفل نصب ساخته نشد.';}}
 if($errors===[]){$meta=json_encode(['service'=>'partners','version'=>'1.0.0','environment'=>$values['environment'],'installed_at'=>gmdate('c')],JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES);if(file_put_contents($lock,$meta."\n",LOCK_EX)===false)$errors[]='ثبت قفل نصب انجام نشد.';}
 if($errors===[]){@rename(__FILE__,__DIR__.'/install.php.locked');echo Renderer::page('نصب موفق','<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">Phase 3 · Partners</div><h1 class="bn-title">سرویس شرکا با موفقیت نصب شد</h1><p class="bn-subtitle">دیتابیس مستقل Partners و ارتباط با سرویس‌های اصلی بررسی شدند.</p></div></div><div class="bn-stats"><div class="bn-stat"><div class="bn-stat-label">مایگریشن‌های جدید</div><div class="bn-stat-value">'.count($applied).'</div></div><div class="bn-stat bn-stat--accent"><div class="bn-stat-label">محیط اجرا</div><div class="bn-stat-value">'.Renderer::e($values['environment']).'</div></div></div><div class="bn-alert bn-alert--success"><strong>مرحله بعد:</strong> آدرس <code>/healthz</code> را بررسی کنید و سپس updaterهای Identity، Loans، Documents و Panel را نصب کنید.</div>');exit;}
}
$req='<div class="bn-table-wrap"><table class="bn-table"><thead><tr><th>پیش‌نیاز</th><th>وضعیت</th></tr></thead><tbody>';foreach($requirements as$r)$req.='<tr><td>'.Renderer::e($r[0]).'</td><td><span class="bn-status '.($r[1]?'bn-status--ok':'bn-status--bad').'">'.Renderer::e((string)$r[2]).'</span></td></tr>';$req.='</tbody></table></div>';$error='';if($errors!==[])$error='<div class="bn-alert bn-alert--error"><strong>نصب کامل نشد</strong><ul><li>'.implode('</li><li>',array_map([Renderer::class,'e'],$errors)).'</li></ul></div>';
$content='<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">Phase 3 · Partners</div><h1 class="bn-title">نصب سرویس شرکا</h1><p class="bn-subtitle">دیتابیس مستقل پذیرندگان/همکاری و اتصال به Identity، Loans و Documents را تنظیم کنید.</p></div></div>'.$error.'<section class="bn-section"><div class="bn-sectionhead"><span class="bn-step">۱</span><div><h2 class="bn-sectiontitle">پیش‌نیازها</h2></div></div>'.$req.'</section><form method="post" autocomplete="off"><input type="hidden" name="_csrf" value="'.Renderer::e(partners_csrf()).'"><section class="bn-section"><div class="bn-sectionhead"><span class="bn-step">۲</span><div><h2 class="bn-sectiontitle">تنظیمات سرویس</h2><p class="bn-sectiondesc"><strong>مهم:</strong> ابتدا در هاست یک دیتابیس خالی و مستقل برای Partners بسازید.</p></div></div><div class="bn-grid bn-grid--2"><div class="bn-field"><label class="bn-label">محیط اجرا</label><select name="environment"><option value="staging"'.($values['environment']==='staging'?' selected':'').'>Staging</option><option value="production"'.($values['environment']==='production'?' selected':'').'>Production</option></select></div><div class="bn-field"><label class="bn-label">Identity URL</label><input name="identity_url" type="url" required value="'.Renderer::e($values['identity_url']).'"></div><div class="bn-field"><label class="bn-label">Loans URL</label><input name="loans_url" type="url" required value="'.Renderer::e($values['loans_url']).'"></div><div class="bn-field"><label class="bn-label">Documents URL</label><input name="documents_url" type="url" required value="'.Renderer::e($values['documents_url']).'"></div><div class="bn-field"><label class="bn-label">DB Host</label><input name="db_host" required value="'.Renderer::e($values['db_host']).'"></div><div class="bn-field"><label class="bn-label">DB Port</label><input name="db_port" inputmode="numeric" required value="'.Renderer::e($values['db_port']).'"></div><div class="bn-field"><label class="bn-label">نام دیتابیس</label><input name="db_name" required value="'.Renderer::e($values['db_name']).'"></div><div class="bn-field"><label class="bn-label">کاربر دیتابیس</label><input name="db_user" required value="'.Renderer::e($values['db_user']).'"></div><div class="bn-field"><label class="bn-label">رمز دیتابیس</label><input name="db_password" type="password" autocomplete="new-password" required></div><div class="bn-field"><label class="bn-label">Service Auth Mode</label><select name="service_auth_mode"><option value="optional"'.($values['service_auth_mode']==='optional'?' selected':'').'>Optional (پیشنهادی فعلی)</option><option value="required"'.($values['service_auth_mode']==='required'?' selected':'').'>Required</option><option value="disabled"'.($values['service_auth_mode']==='disabled'?' selected':'').'>Disabled</option></select></div><div class="bn-field"><label class="bn-label">Shared Service Secret (اختیاری)</label><input name="service_auth_secret" type="password" autocomplete="new-password"></div></div><div class="bn-form-actions"><button class="bn-btn bn-btn--primary" type="submit">نصب و بررسی کامل Partners</button></div></section></form>';
echo Renderer::page('نصب سرویس شرکا',$content,'نصب Partners');
