<?php
declare(strict_types=1);
use Babanoell\Documents\Database\DatabaseIsolationGuard;
use Babanoell\Documents\Database\MigrationRunner;
use Babanoell\Documents\View\Renderer;
use Babanoell\Documents\Support\IniSize;

$root=dirname(__DIR__);$storage=$root.'/storage';$private=$storage.'/private';$lock=$storage.'/installed.lock';$local=$root.'/config/local.env.php';
spl_autoload_register(static function(string$class)use($root):void{$prefix='Babanoell\\Documents\\';if(!str_starts_with($class,$prefix))return;$file=$root.'/src/'.str_replace('\\','/',substr($class,strlen($prefix))).'.php';if(is_file($file))require$file;});
foreach([$storage,$storage.'/tmp',$storage.'/backups',$storage.'/sessions',$private]as$d)if(!is_dir($d))@mkdir($d,0770,true);
if(is_dir($storage.'/sessions')&&is_writable($storage.'/sessions'))session_save_path($storage.'/sessions');session_name('babanoell_documents_install');session_set_cookie_params(['lifetime'=>0,'path'=>'/','secure'=>(!empty($_SERVER['HTTPS'])&&$_SERVER['HTTPS']!=='off'),'httponly'=>true,'samesite'=>'Strict']);session_start();
header('X-Content-Type-Options: nosniff');header('X-Frame-Options: DENY');header('Referrer-Policy: no-referrer');header('X-Robots-Tag: noindex,nofollow,noarchive');header('Cache-Control: no-store,max-age=0');header("Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'");
function documents_csrf():string{if(!is_string($_SESSION['_csrf']??null))$_SESSION['_csrf']=bin2hex(random_bytes(24));return$_SESSION['_csrf'];}
function documents_csrf_ok():bool{return is_string($_POST['_csrf']??null)&&is_string($_SESSION['_csrf']??null)&&hash_equals($_SESSION['_csrf'],$_POST['_csrf']);}
function documents_probe(string$base,string$agent):bool{$url=rtrim($base,'/').'/health';if(function_exists('curl_init')){$ch=curl_init($url);if($ch===false)return false;curl_setopt_array($ch,[CURLOPT_RETURNTRANSFER=>true,CURLOPT_TIMEOUT=>6,CURLOPT_CONNECTTIMEOUT=>4,CURLOPT_FOLLOWLOCATION=>false,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_SSL_VERIFYHOST=>2,CURLOPT_HTTPHEADER=>['Accept: application/json','User-Agent: '.$agent]]);$raw=curl_exec($ch);$status=(int)curl_getinfo($ch,CURLINFO_RESPONSE_CODE);curl_close($ch);}else{$ctx=stream_context_create(['http'=>['timeout'=>6,'ignore_errors'=>true,'follow_location'=>0,'header'=>"Accept: application/json\r\nUser-Agent: {$agent}"],'ssl'=>['verify_peer'=>true,'verify_peer_name'=>true]]);$raw=@file_get_contents($url,false,$ctx);$status=0;foreach($http_response_header??[]as$line)if(preg_match('#^HTTP/\S+\s+(\d{3})#',$line,$m)){$status=(int)$m[1];break;}}$json=is_string($raw)?json_decode($raw,true):null;return$status>=200&&$status<300&&is_array($json)&&($json['status']??null)==='ok';}
function documents_export(array$v):string{return var_export($v,true);}

if(is_file($lock)&&is_file($local)){echo Renderer::page('وضعیت نصب','<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">وضعیت سرویس</div><h1 class="bn-title">سرویس مدارک قبلاً نصب شده است</h1><p class="bn-subtitle">نصب اولیه قفل شده است. برای کنترل سرویس از healthz و برای نسخه‌های بعد از مرکز به‌روزرسانی استفاده کنید.</p></div></div><div class="bn-alert bn-alert--success"><strong>نصب اولیه کامل است.</strong></div>');exit;}
$serverUploadBytes=IniSize::toBytes(ini_get('upload_max_filesize'));$serverPostBytes=IniSize::toBytes(ini_get('post_max_size'));
$requirements=[['PHP ۸.۱ یا بالاتر',PHP_VERSION_ID>=80100,PHP_VERSION],['PDO MySQL',extension_loaded('pdo_mysql'),extension_loaded('pdo_mysql')?'فعال':'غیرفعال'],['Fileinfo',extension_loaded('fileinfo'),extension_loaded('fileinfo')?'فعال':'غیرفعال'],['ZipArchive',class_exists('ZipArchive'),class_exists('ZipArchive')?'فعال':'غیرفعال'],['JSON',extension_loaded('json'),'فعال'],['upload_max_filesize سرور',$serverUploadBytes>=1048576,IniSize::human($serverUploadBytes)],['post_max_size سرور',$serverPostBytes>=2097152,IniSize::human($serverPostBytes)],['دسترسی نوشتن storage',is_writable($storage),is_writable($storage)?'قابل نوشتن':'غیرقابل نوشتن'],['دسترسی ذخیره‌سازی خصوصی',is_writable($private),is_writable($private)?'قابل نوشتن':'غیرقابل نوشتن']];
$values=['environment'=>(string)($_POST['environment']??'staging'),'db_host'=>trim((string)($_POST['db_host']??'localhost')),'db_port'=>trim((string)($_POST['db_port']??'3306')),'db_name'=>trim((string)($_POST['db_name']??'')),'db_user'=>trim((string)($_POST['db_user']??'')),'identity_url'=>trim((string)($_POST['identity_url']??'https://identity.noeel.ir')),'loans_url'=>trim((string)($_POST['loans_url']??'https://loans.noeel.ir')),'max_upload_mb'=>trim((string)($_POST['max_upload_mb']??'10'))];$errors=[];$applied=[];
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
 if(!documents_csrf_ok())$errors[]='اعتبار فرم نصب منقضی شده است. صفحه را تازه‌سازی کنید.';foreach($requirements as$r)if(!$r[1])$errors[]='پیش‌نیاز «'.$r[0].'» برقرار نیست.';
 if(!in_array($values['environment'],['staging','production'],true))$errors[]='محیط اجرا معتبر نیست.';
 if($values['db_name']===''||$values['db_user']===''||trim((string)($_POST['db_password']??''))==='')$errors[]='نام دیتابیس، کاربر و رمز پایگاه داده الزامی است.';
 foreach(['identity_url'=>'احراز هویت','loans_url'=>'تسهیلات']as$k=>$label)if(filter_var($values[$k],FILTER_VALIDATE_URL)===false)$errors[]='آدرس سرویس '.$label.' معتبر نیست.';
 if($values['environment']==='production'&&(!str_starts_with(strtolower($values['identity_url']),'https://')||!str_starts_with(strtolower($values['loans_url']),'https://')))$errors[]='در محیط عملیاتی، ارتباط سرویس‌ها باید فقط با HTTPS انجام شود.';
 $maxMb=(int)$values['max_upload_mb'];if($maxMb<1||$maxMb>50)$errors[]='حداکثر حجم فایل باید بین ۱ تا ۵۰ مگابایت باشد.';$maxBytes=max(0,$maxMb)*1048576;if($serverUploadBytes!==PHP_INT_MAX&&$serverUploadBytes>0&&$maxBytes>$serverUploadBytes)$errors[]='حد انتخاب‌شده از upload_max_filesize سرور بیشتر است. مقدار فرم را کاهش دهید یا محدودیت PHP هاست را افزایش دهید.';if($serverPostBytes!==PHP_INT_MAX&&$serverPostBytes>0&&($maxBytes+1048576)>$serverPostBytes)$errors[]='post_max_size سرور برای این حجم فایل و سربار فرم کافی نیست. حد فایل را کاهش دهید یا post_max_size را افزایش دهید.';
 if($errors===[]&&!documents_probe($values['identity_url'],'BabanoellDocumentsInstaller/1.0.0'))$errors[]='ارتباط با سرویس احراز هویت تأیید نشد.';
 if($errors===[]&&!documents_probe($values['loans_url'],'BabanoellDocumentsInstaller/1.0.0'))$errors[]='ارتباط با سرویس تسهیلات تأیید نشد.';
 if($errors===[]){try{$port=(int)$values['db_port'];$dsn=sprintf('mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4',$values['db_host'],$port,$values['db_name']);$pdo=new PDO($dsn,$values['db_user'],(string)$_POST['db_password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_DEFAULT_FETCH_MODE=>PDO::FETCH_ASSOC,PDO::ATTR_EMULATE_PREPARES=>false]);$pdo->query('SELECT 1')->fetchColumn();DatabaseIsolationGuard::assertDocumentsDatabase($pdo);$runner=new MigrationRunner($pdo,$root.'/database/migrations');$applied=$runner->up();}catch(Throwable$e){@file_put_contents($storage.'/install-error.log','['.gmdate('c').'] '.get_class($e).': '.$e->getMessage()."\n",FILE_APPEND|LOCK_EX);$errors[]='اتصال یا ساخت ساختار دیتابیس کامل نشد. جزئیات فنی در storage/install-error.log ثبت شد.';}}
 if($errors===[]){$cfg=['APP_ENV'=>$values['environment'],'SERVICE_NAME'=>'documents','DOCUMENTS_DB_HOST'=>$values['db_host'],'DOCUMENTS_DB_PORT'=>$values['db_port'],'DOCUMENTS_DB_NAME'=>$values['db_name'],'DOCUMENTS_DB_USER'=>$values['db_user'],'DOCUMENTS_DB_PASSWORD'=>(string)$_POST['db_password'],'DOCUMENTS_DB_CHARSET'=>'utf8mb4','DOCUMENTS_IDENTITY_BASE_URL'=>rtrim($values['identity_url'],'/'),'DOCUMENTS_LOANS_BASE_URL'=>rtrim($values['loans_url'],'/'),'DOCUMENTS_HTTP_TIMEOUT_SECONDS'=>'8','DOCUMENTS_MAX_UPLOAD_BYTES'=>(string)($maxMb*1024*1024)];$content="<?php\ndeclare(strict_types=1);\n\n// Generated by Documents installer. KEEP PRIVATE.\nreturn ".documents_export($cfg).";\n";$tmp=$local.'.tmp-'.bin2hex(random_bytes(4));if(file_put_contents($tmp,$content,LOCK_EX)===false||!rename($tmp,$local))$errors[]='فایل config/local.env.php ساخته نشد.';else @chmod($local,0640);}
 if($errors===[]){try{require_once$root.'/config/env.php';$config=Babanoell\Documents\App\Config::fromEnvironment();$runtime=Babanoell\Documents\Database\Connection::fromConfig($config);$runtime->query('SELECT 1')->fetchColumn();if((string)$runtime->query('SELECT DATABASE()')->fetchColumn()!==$values['db_name'])throw new RuntimeException('runtime database mismatch');if(!documents_probe($config->identityBaseUrl(),'BabanoellDocumentsInstaller/1.0.0'))throw new RuntimeException('runtime identity health failed');if(!documents_probe($config->loansBaseUrl(),'BabanoellDocumentsInstaller/1.0.0'))throw new RuntimeException('runtime loans health failed');if(!is_writable($private))throw new RuntimeException('private storage not writable');}catch(Throwable$e){@file_put_contents($storage.'/install-error.log','['.gmdate('c').'] runtime: '.$e->getMessage()."\n",FILE_APPEND|LOCK_EX);$errors[]='بررسی نهایی مسیر واقعی سرویس موفق نبود. قفل نصب ساخته نشد.';}}
 if($errors===[]){$meta=json_encode(['service'=>'documents','version'=>'1.0.0','environment'=>$values['environment'],'installed_at'=>gmdate('c')],JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES);if(file_put_contents($lock,$meta."\n",LOCK_EX)===false)$errors[]='ثبت قفل نصب انجام نشد.';else @chmod($lock,0640);}
 if($errors===[]){@rename(__FILE__,__DIR__.'/install.php.locked');echo Renderer::page('نصب موفق','<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">راه‌اندازی تکمیل شد</div><h1 class="bn-title">سرویس مدارک با موفقیت راه‌اندازی شد</h1><p class="bn-subtitle">پایگاه داده مستقل، ذخیره‌سازی خصوصی و ارتباط با سرویس‌های احراز هویت و تسهیلات بررسی شدند.</p></div></div><div class="bn-stats"><div class="bn-stat"><div class="bn-stat-label">تغییرات دیتابیس</div><div class="bn-stat-value">'.count($applied).'</div></div><div class="bn-stat"><div class="bn-stat-label">حد فایل</div><div class="bn-stat-value">'.Renderer::digits((string)$maxMb).' مگابایت</div></div><div class="bn-stat bn-stat--accent"><div class="bn-stat-label">محیط اجرا</div><div class="bn-stat-value">'.Renderer::e($values['environment']).'</div></div></div><div class="bn-alert bn-alert--success"><strong>مرحله بعد:</strong> آدرس <code>/healthz</code> را بررسی کنید؛ وضعیت پایگاه داده، فضای ذخیره‌سازی خصوصی، احراز هویت و تسهیلات باید همگی «سالم» باشند.</div>');exit;}
}
$req='<div class="bn-table-wrap"><table class="bn-table"><thead><tr><th>پیش‌نیاز</th><th>وضعیت</th></tr></thead><tbody>';foreach($requirements as$r)$req.='<tr><td>'.Renderer::e($r[0]).'</td><td><span class="bn-status '.($r[1]?'bn-status--ok':'bn-status--bad').'">'.Renderer::e((string)$r[2]).'</span></td></tr>';$req.='</tbody></table></div>';$error='';if($errors!==[])$error='<div class="bn-alert bn-alert--error"><strong>نصب کامل نشد</strong><ul><li>'.implode('</li><li>',array_map([Renderer::class,'e'],$errors)).'</li></ul></div>';
$content='<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">راه‌اندازی سرویس مدارک</div><h1 class="bn-title">راه‌اندازی ذخیره‌سازی خصوصی مدارک</h1><p class="bn-subtitle">پایگاه داده مستقل سرویس مدارک و ارتباط آن با سرویس‌های مرکزی را تنظیم کنید.</p></div></div>'.$error.'<section class="bn-section"><div class="bn-sectionhead"><span class="bn-step">۱</span><div><h2 class="bn-sectiontitle">پیش‌نیازهای سرور</h2><p class="bn-sectiondesc">همه موارد باید سبز باشند.</p></div></div>'.$req.'</section><section class="bn-section"><div class="bn-sectionhead"><span class="bn-step">۲</span><div><h2 class="bn-sectiontitle">تنظیمات سرویس</h2><p class="bn-sectiondesc">اطلاعات فقط در config/local.env.php خصوصی ذخیره می‌شوند.</p></div></div><form method="post" autocomplete="off"><input type="hidden" name="_csrf" value="'.Renderer::e(documents_csrf()).'"><div class="bn-grid"><div class="bn-field"><label class="bn-label">محیط اجرا</label><select name="environment"><option value="staging"'.($values['environment']==='staging'?' selected':'').'>آزمایشی (Staging)</option><option value="production"'.($values['environment']==='production'?' selected':'').'>عملیاتی (Production)</option></select></div><div class="bn-field"><label class="bn-label">حداکثر حجم هر فایل (مگابایت)</label><input type="number" min="1" max="50" name="max_upload_mb" value="'.Renderer::e($values['max_upload_mb']).'" required></div><div class="bn-field"><label class="bn-label">میزبان پایگاه داده</label><input name="db_host" value="'.Renderer::e($values['db_host']).'" required></div><div class="bn-field"><label class="bn-label">درگاه پایگاه داده</label><input name="db_port" inputmode="numeric" value="'.Renderer::e($values['db_port']).'" required></div><div class="bn-field"><label class="bn-label">نام پایگاه داده مدارک</label><input name="db_name" value="'.Renderer::e($values['db_name']).'" required></div><div class="bn-field"><label class="bn-label">کاربر پایگاه داده مدارک</label><input name="db_user" value="'.Renderer::e($values['db_user']).'" required></div><div class="bn-field"><label class="bn-label">رمز پایگاه داده</label><input type="password" name="db_password" autocomplete="new-password" required></div><div class="bn-field"><label class="bn-label">آدرس سرویس احراز هویت</label><input type="url" name="identity_url" value="'.Renderer::e($values['identity_url']).'" required></div><div class="bn-field"><label class="bn-label">آدرس سرویس تسهیلات</label><input type="url" name="loans_url" value="'.Renderer::e($values['loans_url']).'" required></div></div><div class="bn-alert bn-alert--hint bn-alert--after"><strong>اصل جداسازی:</strong> پایگاه داده مدارک نباید با پایگاه داده سرویس احراز هویت یا تسهیلات مشترک باشد و فایل‌ها در storage/private خارج از دسترسی مستقیم وب ذخیره می‌شوند.</div><div class="bn-form-actions"><button class="bn-btn bn-btn--primary" type="submit">نصب و بررسی کامل سرویس</button></div></form></section>';
echo Renderer::page('نصب سرویس مدارک',$content,'نصب اولیه');
