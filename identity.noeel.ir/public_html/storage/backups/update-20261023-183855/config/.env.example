APP_ENV=local
SERVICE_NAME=auth-service
SERVICE_PORT=8080
AUTH_DB_HOST=mariadb
AUTH_DB_PORT=3306
AUTH_DB_NAME=babanoell_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY_AUTH_DB_PASSWORD
AUTH_DB_CHARSET=utf8mb4
REDIS_HOST=redis
AUTH_ENVIRONMENT=local
AUTH_ALLOW_HTTP_LOGIN_IN_LOCAL=false
AUTH_ALLOW_HTTP_LOGIN_IN_STAGING=false
AUTH_ALLOW_HTTP_LOGIN_IN_PRODUCTION=false
AUTH_LOGIN_ENABLED=false
AUTH_SESSION_ISSUING_ENABLED=false
AUTH_REFRESH_ENABLED=false
AUTH_REQUIRE_TOKEN_PEPPER=true
AUTH_SESSION_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600
AUTH_TOKEN_PEPPER=change-me-only-in-local-tests
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_AUDIT_RETENTION_DAYS=365
AUTH_PASSWORD_HASH_MEMORY_COST=65536
AUTH_PASSWORD_HASH_TIME_COST=4
AUTH_PASSWORD_HASH_THREADS=2
