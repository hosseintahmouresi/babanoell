Options -Indexes
RewriteEngine On

# Browser icon fallback, also available before application login/install.
RewriteRule ^favicon\.ico$ public/ui-asset.php?file=favicon.ico [L]
RewriteRule ^(bin|config|src|database|storage|tests)(/|$) - [F,L,NC]
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.+)$ public/$1 [L]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^ public/index.php [L,QSA]
<FilesMatch "(^\.|local\.env|\.log$|\.lock$|\.zip$)">
 Require all denied
</FilesMatch>
