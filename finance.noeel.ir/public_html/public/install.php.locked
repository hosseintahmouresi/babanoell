declare(strict_types=1);
use Babanoell\Finance\Database\MigrationRunner;use Babanoell\Finance\Database\DatabaseIsolationGuard;use Babanoell\Finance\View\Renderer;
$root=dirname(__DIR__);$storage=$root.'/storage';$lock=$storage.'/installed.lock';$local=$root.'/config/local.env.php';spl_autoload_register(static function(string$class)use($root):void{$p='Babanoell\\Finance\\';if(!str_starts_with($class,$p))return;$f=$root.'/src/'.str_replace('\\','/',substr($class,strlen($p))).'.php';if(is_file($f))require$f;});foreach([$storage,$storage.'/tmp',$storage.'/backups']as$d)if(!is_dir($d))@mkdir($d,0770,true);if(is_dir($storage.'/tmp')&&is_writable($storage.'/tmp'))session_save_path($storage.'/tmp');session_name('babanoell_finance_install');session_set_cookie_params(['lifetime'=>0,'path'=>'/','secure'=>(!empty($_SERVER['HTTPS'])&&$_SERVER['HTTPS']!=='off'),'httponly'=>true,'samesite'=>'Strict']);session_start();header('X-Content-Type-Options:nosniff');header('X-Frame-Options:DENY');header('Referrer-Policy:no-referrer');header('X-Robots-Tag:noindex,nofollow,noarchive');header('Cache-Control:no-store,max-age=0');header("Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'");
function fin_csrf():string{if(!is_string($_SESSION['_csrf']??null))$_SESSION['_csrf']=bin2hex(random_bytes(24));return$_SESSION['_csrf'];}function fin_csrf_ok():bool{return is_string($_POST['_csrf']??null)&&is_string($_SESSION['_csrf']??null)&&hash_equals($_SESSION['_csrf'],$_POST['_csrf']);}function fin_probe(string$base):bool{$url=rtrim($base,'/').'/health';$ctx=stream_context_create(['http'=>['timeout'=>6,'ignore_errors'=>true,'follow_location'=>0,'header'=>"Accept: application/json\r\nUser-Agent: BabanoellFinanceInstaller/1.0.0"],'ssl'=>['verify_peer'=>true,'verify_peer_name'=>true]]);$raw=@file_get_contents($url,false,$ctx);$status=0;foreach($http_response_header??[]as$line)if(preg_match('#^HTTP/\S+\s+(\d{3})#',$line,$m)){$status=(int)$m[1];break;}$j=is_string($raw)?json_decode($raw,true):null;return$status>=200&&$status<300&&is_array($j)&&($j['status']??null)==='ok';}
if(is_file($lock)&&is_file($local)){echo Renderer::page('وضعیت نصب','<div class="bn-alert bn-alert--success"><strong>Finance قبلاً نصب شده است.</strong></div><p><a href="/healthz">بررسی healthz</a> · <a href="/update.php">مرکز به‌روزرسانی</a></p>');exit;}
$v=['environment'=>(string)($_POST['environment']??'production'),'db_host'=>trim((string)($_POST['db_host']??'localhost')),'db_port'=>trim((string)($_POST['db_port']??'3306')),'db_name'=>trim((string)($_POST['db_name']??'')),'db_user'=>trim((string)($_POST['db_user']??'')),'identity_url'=>trim((string)($_POST['identity_url']??'https://identity.noeel.ir')),'loans_url'=>trim((string)($_POST['loans_url']??'https://loans.noeel.ir')),'partners_url'=>trim((string)($_POST['partners_url']??'https://partners.noeel.ir')),'documents_url'=>trim((string)($_POST['documents_url']??'https://documents.noeel.ir')),'service_auth_mode'=>strtolower(trim((string)($_POST['service_auth_mode']??'optional')))];$errors=[];
if(($_SERVER['REQUEST_METHOD']??'GET')==='POST'){
 if(!fin_csrf_ok())$errors[]='اعتبار فرم منقضی شده است.';if(!extension_loaded('pdo_mysql'))$errors[]='PDO MySQL فعال نیست.';if($v['db_name']===''||$v['db_user']===''||trim((string)($_POST['db_password']??''))==='')$errors[]='اطلاعات دیتابیس الزامی است.';if(!in_array($v['environment'],['staging','production'],true))$errors[]='محیط اجرا معتبر نیست.';if(!in_array($v['service_auth_mode'],['disabled','optional','required'],true))$errors[]='Service Auth Mode معتبر نیست.';$secret=trim((string)($_POST['service_auth_secret']??''));if($v['service_auth_mode']==='required'&&$secret==='')$errors[]='Shared Service Secret در حالت Required الزامی است.';
 foreach(['identity_url','loans_url','partners_url','documents_url']as$k){if(filter_var($v[$k],FILTER_VALIDATE_URL)===false)$errors[]='آدرس سرویس معتبر نیست: '.$k;if($v['environment']==='production'&&!str_starts_with(strtolower($v[$k]),'https://'))$errors[]='در Production همه سرویس‌ها باید HTTPS باشند.';}
 if($errors===[]){try{$dsn='mysql:host='.$v['db_host'].';port='.(int)$v['db_port'].';dbname='.$v['db_name'].';charset=utf8mb4';$pdo=new PDO($dsn,$v['db_user'],(string)$_POST['db_password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_DEFAULT_FETCH_MODE=>PDO::FETCH_ASSOC,PDO::ATTR_EMULATE_PREPARES=>false]);DatabaseIsolationGuard::assertFinanceDatabase($pdo);$applied=(new MigrationRunner($pdo,$root.'/database/migrations'))->up();$config=['SERVICE_NAME'=>'finance','APP_ENV'=>$v['environment'],'FINANCE_DB_HOST'=>$v['db_host'],'FINANCE_DB_PORT'=>$v['db_port'],'FINANCE_DB_NAME'=>$v['db_name'],'FINANCE_DB_USER'=>$v['db_user'],'FINANCE_DB_PASSWORD'=>(string)$_POST['db_password'],'FINANCE_DB_CHARSET'=>'utf8mb4','FINANCE_IDENTITY_BASE_URL'=>$v['identity_url'],'FINANCE_LOANS_BASE_URL'=>$v['loans_url'],'FINANCE_PARTNERS_BASE_URL'=>$v['partners_url'],'FINANCE_DOCUMENTS_BASE_URL'=>$v['documents_url'],'FINANCE_HTTP_TIMEOUT_SECONDS'=>'8','NOEEL_SERVICE_AUTH_MODE'=>$v['service_auth_mode'],'NOEEL_SERVICE_SHARED_SECRET'=>$secret];$php="<?php\ndeclare(strict_types=1);\nreturn ".var_export($config,true).";\n";if(file_put_contents($local,$php,LOCK_EX)===false)throw new RuntimeException('نوشتن تنظیمات خصوصی انجام نشد.');@chmod($local,0600);file_put_contents($lock,json_encode(['installed_at'=>gmdate('c'),'migrations'=>count($applied)]),LOCK_EX);$self=__FILE__;$locked=$root.'/public/install.php.locked';if(is_file($self))@rename($self,$locked);echo Renderer::page('نصب Finance','<div class="bn-alert bn-alert--success"><strong>Finance 1.0.0 نصب شد.</strong></div><p>Migrationها: '.count($applied).'</p><p>Identity: '.(fin_probe($v['identity_url'])?'OK':'Check').' · Loans: '.(fin_probe($v['loans_url'])?'OK':'Check').' · Partners: '.(fin_probe($v['partners_url'])?'OK':'Check').' · Documents: '.(fin_probe($v['documents_url'])?'OK':'Check').'</p><p><a href="/healthz">healthz</a></p>');exit;}catch(Throwable$e){$errors[]=$e->getMessage();}}
}
$alert=$errors?'<div class="bn-alert bn-alert--error"><strong>نصب کامل نشد</strong><br>'.implode('<br>',array_map([Renderer::class,'e'],$errors)).'</div>':'';$field=static fn(string$l,string$n,string$val,string$t='text',bool$required=true)=>'<div class="bn-field"><label class="bn-label">'.Renderer::e($l).'</label><input type="'.$t.'" name="'.$n.'" value="'.Renderer::e($val).'"'.($required?' required':'').'></div>';$content='<div class="bn-pagehead"><div class="bn-pagehead-main"><div class="bn-eyebrow">Phase 7 · Finance</div><h1 class="bn-title">نصب سرویس مالی</h1><p class="bn-subtitle">یک دیتابیس خالی و مستقل برای Finance وارد کنید.</p></div></div>'.$alert.'<form method="post"><input type="hidden" name="_csrf" value="'.Renderer::e(fin_csrf()).'"><div class="bn-grid bn-grid--2"><div class="bn-field"><label class="bn-label">محیط</label><select name="environment"><option value="production">Production</option><option value="staging">Staging</option></select></div>'.$field('DB Host','db_host',$v['db_host']).$field('DB Port','db_port',$v['db_port']).$field('DB Name','db_name',$v['db_name']).$field('DB User','db_user',$v['db_user']).$field('DB Password','db_password','','password').$field('Identity URL','identity_url',$v['identity_url'],'url').$field('Loans URL','loans_url',$v['loans_url'],'url').$field('Partners URL','partners_url',$v['partners_url'],'url').$field('Documents URL','documents_url',$v['documents_url'],'url').'<div class="bn-field"><label class="bn-label">Service Auth Mode</label><select name="service_auth_mode"><option value="optional">Optional</option><option value="required">Required</option><option value="disabled">Disabled</option></select></div>'.$field('Shared Service Secret','service_auth_secret','','password',false).'</div><div class="bn-form-actions"><button class="bn-btn bn-btn--primary">نصب Finance</button></div></form>';echo Renderer::page('نصب Finance',$content,'نصب Finance');
